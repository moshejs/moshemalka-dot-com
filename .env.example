# "Right now" section on the homepage (Spotify + Oura).
# Copy to .env.local for local dev; set the same keys in Vercel → Settings →
# Environment Variables for production. Each provider is independent, and the
# section hides itself when neither is connected.
#
# Both apps use the same redirect URI (Spotify rejects "localhost"):
#   http://127.0.0.1:8888/callback

# ── Spotify ───────────────────────────────────────────────────────────────────
# 1. Create an app at https://developer.spotify.com/dashboard (Web API),
#    add the redirect URI above, copy the client ID + secret below.
# 2. Run: yarn connect spotify   → writes SPOTIFY_REFRESH_TOKEN here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# ── Oura ──────────────────────────────────────────────────────────────────────
# Personal access tokens are gone (Dec 2025); Oura is OAuth2 with single-use
# refresh tokens, so the rotating pair lives in Redis, not in env.
# 1. Create an app in Oura's developer portal (https://developer.ouraring.com),
#    add the redirect URI above, copy the client ID + secret below.
# 2. Add the Redis store (step below), then run: yarn connect oura
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Oura only allows http for "localhost" (Spotify only for 127.0.0.1), so
# register this one in the Oura app instead of the default above.
OURA_REDIRECT_URI=http://localhost:8888/callback

# ── Token store (Upstash Redis) ───────────────────────────────────────────────
# Vercel → Storage → Marketplace → Upstash Redis → connect to this project.
# It sets these in Vercel automatically; copy them here for local dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=
