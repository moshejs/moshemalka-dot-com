# Live-stats providers for the Signal section on the homepage.
# Copy to .env.local for local dev; set the same keys in Vercel project settings
# for production. Each provider is independent — the section degrades gracefully
# (hides) when none are configured.

# ── Oura ──────────────────────────────────────────────────────────────────────
# Personal Access Token. Generate at:
#   https://cloud.ouraring.com/personal-access-tokens
# Single value, no OAuth dance.
OURA_PAT=

# ── Spotify ───────────────────────────────────────────────────────────────────
# Needs a one-time refresh-token bootstrap, then it self-renews access tokens.
#
# 1. Create an app: https://developer.spotify.com/dashboard
#    Add Redirect URI: http://localhost:3000/callback (any unused path is fine)
# 2. Open this URL in a browser, replacing CLIENT_ID:
#    https://accounts.spotify.com/authorize?client_id=CLIENT_ID&response_type=code&redirect_uri=http%3A%2F%2Flocalhost%3A3000%2Fcallback&scope=user-read-currently-playing%20user-read-recently-played
# 3. After approving, you'll be redirected to localhost with ?code=AUTH_CODE in
#    the URL. Copy AUTH_CODE.
# 4. Exchange it for a refresh token (one-shot):
#    curl -X POST https://accounts.spotify.com/api/token \
#      -H "Authorization: Basic $(echo -n CLIENT_ID:CLIENT_SECRET | base64)" \
#      -d grant_type=authorization_code \
#      -d code=AUTH_CODE \
#      -d redirect_uri=http://localhost:3000/callback
#    The response includes refresh_token — that's what goes below.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
