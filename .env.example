# Neon Postgres connection string. Create one at https://neon.tech
# (Vercel → Storage → Create Database → Neon also works, auto-injects this var)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# 32+ random characters used to encrypt the admin session cookie.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=replace-with-32-or-more-random-characters

# The passphrase you’ll type at /study/admin to unlock book editing.
STUDY_PASSWORD=pick-something-only-you-know
